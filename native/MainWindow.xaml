<Window x:Class="Datto.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Datto" Icon="Assets/Datto.ico" Width="1180" Height="380" MinWidth="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{DynamicResource Text}" PreviewKeyDown="OnKey">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="17,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DA0A7"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Width" Value="254"/><Setter Property="Margin" Value="0,4,18,9"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Padding="3" CornerRadius="12" BorderBrush="Transparent" BorderThickness="2"><Border Background="{DynamicResource Card}" CornerRadius="7"><Border.Effect><DropShadowEffect Color="#222222" BlurRadius="6" ShadowDepth="2" Opacity="0.12"/></Border.Effect><ContentPresenter/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#4096F5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="PreviewMouseRightButtonDown" Handler="SelectContextCard"/><EventSetter Event="MouseDoubleClick" Handler="CardDoubleClick"/><EventSetter Event="Loaded" Handler="AttachCardMenu"/>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="26,12,26,8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Input}" CornerRadius="8" Margin="0,6,0,6"><Grid><TextBlock Text="⌕" FontSize="22" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBox Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" x:Name="Search" Background="Transparent" BorderThickness="0" Padding="34,7,10,7" TextChanged="SearchChanged" ToolTip="搜索 · Ctrl K"/><TextBlock Text="搜索" Foreground="{DynamicResource Muted}" Margin="35,7,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="AllTab" Content="◷  剪贴板历史" Tag="all" Background="{DynamicResource Tab}" Foreground="{DynamicResource Text}" Click="FilterClick"/><Button x:Name="FavoriteTab" Content="●  收藏" Foreground="{DynamicResource Accent}" Tag="favorite" Click="FilterClick" Margin="8,0,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="datto" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="PauseButton" Content="Ⅱ" FontSize="16" Padding="10,3" Click="PauseClick" ToolTip="暂停监听"/><Button Content="⚙" FontSize="16" Padding="10,3" Click="SettingsClick" ToolTip="设置"/><Button Content="×" FontSize="20" Padding="10,3" Click="HideClick" ToolTip="收起 · Esc"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,9,0,2">
    <ListBox x:Name="History" Background="Transparent" BorderThickness="0" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="ScrollCards">
     <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><Grid>
      <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border CornerRadius="7,7,0,0" Padding="14,10"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource TextHeader}"/><Style.Triggers><DataTrigger Binding="{Binding IsLink}" Value="True"><Setter Property="Background" Value="{DynamicResource LinkHeader}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding KindLabel}" Foreground="White" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource HeaderText}" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding KindGlyph}" Foreground="{DynamicResource HeaderText}" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
      <Border Grid.Row="1" Padding="16,14" ClipToBounds="True"><Grid><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="13" LineHeight="21" Foreground="{DynamicResource Text}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid></Border>
      <Grid Grid.Row="2" Margin="15,0,15,8"><TextBlock Text="{Binding FooterLabel}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding QuickLabel}" HorizontalAlignment="Right" Margin="0,0,20,0" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding FavoriteMark}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Empty" Text="复制一些内容，历史记录就会出现在这里" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   </Grid>
   <Grid Grid.Row="2"><TextBlock x:Name="Status" Text="Ctrl 1–9 快速粘贴   ·   ← → 选择   ·   空格预览   ·   Enter 粘贴" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="ShortcutHint" Text="Ctrl Shift V" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid>
  </Grid>
 </Border>
</Window>










